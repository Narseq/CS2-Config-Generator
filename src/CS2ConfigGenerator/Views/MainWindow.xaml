<Window x:Class="CS2ConfigGenerator.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CS2ConfigGenerator.Views"
        Title="CS2 Config Generator" Width="1500" Height="860" MinWidth="1100" MinHeight="640"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="460" />
                <ColumnDefinition Width="1.15*" MinWidth="320" />
                <ColumnDefinition Width="1.15*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <views:KeyboardView />
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0">
                <views:BindEditorView DataContext="{Binding Editor}" />
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <views:ConfigPreviewView />
            </Border>

            <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Margin="4,8,0,0" Text="{Binding StatusMessage}"
                       Style="{StaticResource MutedText}" />
        </Grid>

        <!-- Ekran powitalny -->
        <Border Background="#E60F1318" Visibility="{Binding ShowWelcome, Converter={StaticResource BoolToVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
                <TextBlock Text="CS2 Config Generator" FontSize="36" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="Kliknij klawisz, wybierz akcję i wygeneruj config." FontSize="20" Margin="0,14,0,0"
                           TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" />
                <TextBlock Margin="0,12,0,0" Style="{StaticResource MutedText}" TextAlignment="Center"
                           Text="Gotowy plik autoexec.cfg skopiujesz, zapiszesz ręcznie albo wrzucisz prosto do folderu CS2." />
                <Button Content="Zaczynij" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}"
                        FontSize="16" Padding="34,10" Margin="0,26,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
