<UserControl x:Class="CS2ConfigGenerator.Views.ConfigPreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Podgląd autoexec.cfg" Style="{StaticResource SectionTitle}" />

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Presety" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
            <ItemsControl ItemsSource="{Binding Presets}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Name}" ToolTip="{Binding Description}"
                                Command="{Binding DataContext.LoadPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <CheckBox IsChecked="{Binding TrainingMode}" Content="Tryb treningowy (komendy tylko na lokalny serwer)"
                      Margin="0,2,0,8" ToolTip="Bez tego komendy treningowe (noclip, give, sv_*…) nie trafią do pliku" />

            <WrapPanel>
                <Button Content="Kopiuj config" Command="{Binding CopyConfigCommand}" />
                <Button Content="Zapisz jako…" Command="{Binding SaveAsCommand}" />
                <Button Content="Zapisz do CS2" Command="{Binding SaveToCs2Command}" Style="{StaticResource PrimaryButton}" />
                <Button Content="Importuj config" Command="{Binding ImportCommand}" />
            </WrapPanel>

            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Zmień…" Command="{Binding ChooseCs2FolderCommand}"
                        Padding="8,2" Margin="8,0,0,0" />
                <TextBlock Text="{Binding Cs2PathDisplay}" Style="{StaticResource MutedText}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Cs2PathDisplay}" />
            </DockPanel>
        </StackPanel>

        <Expander DockPanel.Dock="Bottom" Header="{Binding UnrecognizedHeader}" Margin="0,8,0,0" Foreground="{StaticResource TextBrush}"
                  Visibility="{Binding HasUnrecognized, Converter={StaticResource BoolToVis}}">
            <ListBox ItemsSource="{Binding UnrecognizedLines}" MaxHeight="150" FontFamily="Consolas" />
        </Expander>

        <TextBox Text="{Binding ConfigText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="13"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" AcceptsReturn="True" />
    </DockPanel>
</UserControl>
