<UserControl x:Class="CS2ConfigGenerator.Views.BindEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Przypisanie akcji" Style="{StaticResource SectionTitle}" />

        <!-- Podpowiedź, gdy nie wybrano klawisza -->
        <TextBlock Text="Kliknij klawisz na klawiaturze, aby przypisać mu akcję.">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasKey}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Grid Visibility="{Binding HasKey, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="{Binding KeyTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />

                <!-- Klawisz zajęty -->
                <Border Background="#3A2D12" BorderBrush="{StaticResource WarnBrush}" BorderThickness="1" CornerRadius="4"
                        Padding="10" Margin="0,0,0,10"
                        Visibility="{Binding IsKeyOccupied, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="⚠ Klawisz jest zajęty" FontWeight="SemiBold" Foreground="{StaticResource WarnBrush}" />
                        <TextBlock Text="{Binding OccupiedWarning}" TextWrapping="Wrap" Margin="0,4,0,8" />
                        <WrapPanel>
                            <Button Content="Nadpisz" Command="{Binding OverwriteCommand}" Style="{StaticResource PrimaryButton}" />
                            <Button Content="Edytuj istniejący" Command="{Binding EditExistingCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <ScrollViewer Grid.Row="1">
                <StackPanel IsEnabled="{Binding CanEdit}">
                    <TextBlock Text="Kategoria" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                    <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource ChipItem}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" FontFamily="Segoe UI Emoji" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding Name}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Akcje wybranej kategorii (klik dodaje komendę do binda) -->
                    <TextBlock Text="Akcje — kliknij, aby dodać" Style="{StaticResource MutedText}" Margin="0,8,0,4"
                               Visibility="{Binding ShowActions, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl ItemsSource="{Binding Actions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name}" Padding="10,5"
                                        Command="{Binding DataContext.AddActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Własna komenda -->
                    <StackPanel Visibility="{Binding IsCustomCategory, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Własna komenda konsolowa CS2 (średnik rozdziela komendy)" Style="{StaticResource MutedText}" Margin="0,8,0,4" />
                        <TextBox Text="{Binding CustomCommand, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="{Binding CustomCommandError}" Foreground="{StaticResource DangerBrush}" Margin="0,4,0,0" />
                        <Button Content="Dodaj komendę" Command="{Binding AddCustomCommand}" Margin="0,6,0,0" HorizontalAlignment="Left" />
                    </StackPanel>

                    <TextBlock Text="Komendy tego binda" Style="{StaticResource MutedText}" Margin="0,12,0,4" />
                    <ItemsControl ItemsSource="{Binding Commands}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource PanelAltBrush}" CornerRadius="4" Padding="8,4" Margin="0,0,0,4">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="✕" Padding="7,1" Margin="8,0,0,0"
                                                Style="{StaticResource DangerButton}" ToolTip="Usuń komendę"
                                                Command="{Binding DataContext.RemoveCommandCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <TextBlock Text="{Binding Text}" FontFamily="Consolas" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                <TextBlock Text="Podgląd binda" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                <Border Background="#0B0E12" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" Padding="8" CornerRadius="4">
                    <TextBlock Text="{Binding PreviewText}" FontFamily="Consolas" TextWrapping="Wrap" />
                </Border>
                <TextBlock Text="{Binding ValidationError}" Foreground="{StaticResource WarnBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                <WrapPanel Margin="0,10,0,0">
                    <Button Content="Zapisz" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" />
                    <Button Content="Usuń bind" Command="{Binding RemoveBindCommand}" Style="{StaticResource DangerButton}" />
                    <Button Content="Wyczyść wszystkie bindy" Command="{Binding ClearAllCommand}" Style="{StaticResource DangerButton}" />
                </WrapPanel>
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
